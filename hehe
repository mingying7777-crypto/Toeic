<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TOEIC 750+ Vocabulary Challenge</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .animate-bounce-short {
            animation: bounce 0.5s ease-in-out 2;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .card-flip {
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- Header / Navbar -->
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="showTopicSelection()">
                <div class="bg-gradient-to-tr from-indigo-500 to-purple-500 p-2.5 rounded-xl shadow-lg shadow-indigo-500/20">
                    <i data-lucide="award" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">TOEIC 750+ Master</h1>
                    <p class="text-xs text-slate-400">Trò chơi Luyện Từ Vựng Nâng Cao</p>
                </div>
            </div>
            
            <div id="top-stats" class="hidden flex items-center space-x-6 bg-slate-800/80 px-4 py-2 rounded-full border border-slate-700">
                <div class="flex items-center space-x-2 text-amber-400 font-semibold">
                    <i data-lucide="zap" class="w-4 h-4 fill-amber-400"></i>
                    <span id="streak-count">0</span> <span class="text-xs text-slate-400 font-normal">Chuỗi</span>
                </div>
                <div class="h-4 w-px bg-slate-700"></div>
                <div class="flex items-center space-x-2 text-emerald-400 font-semibold">
                    <i data-lucide="trophy" class="w-4 h-4"></i>
                    <span id="score-count">0</span> <span class="text-xs text-slate-400 font-normal">Điểm</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Container --><main class="max-w-4xl mx-auto px-4 py-8 flex-1 w-full flex flex-col justify-center">
        
        <!-- View 1: Topic Selection -->
        <div id="view-topic-select" class="space-y-6">
            <div class="text-center space-y-2 mb-8">
                <h2 class="text-3xl font-extrabold text-white">Chọn Chủ Đề Từ Vựng</h2>
                <p class="text-slate-400 max-w-lg mx-auto">Thử thách bản thân với các nhóm từ vựng mức độ 750+ chuẩn định dạng đề thi TOEIC mới nhất.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="topic-grid">
                <!-- Topics inserted by JS -->
            </div>
        </div>

        <!-- View 2: Quiz Game Interface -->
        <div id="view-quiz" class="hidden space-y-6">
            <!-- Progress & Controls -->
            <div class="flex items-center justify-between gap-4">
                <button onclick="confirmExit()" class="p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </button>
                <div class="flex-1">
                    <div class="flex justify-between text-xs font-semibold text-slate-400 mb-2">
                        <span id="quiz-topic-title">Chủ đề</span>
                        <span>Câu <span id="current-q-num" class="text-indigo-400">1</span>/<span id="total-q-num">10</span></span>
                    </div>
                    <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-700">
                        <div id="progress-bar" class="bg-gradient-to-r from-indigo-500 to-purple-500 h-full rounded-full transition-all duration-300" style="width: 10%"></div>
                    </div>
                </div>
                <div id="timer-badge" class="flex items-center space-x-1.5 bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700 text-amber-400 font-bold text-sm">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                    <span id="timer-text">20s</span>
                </div>
            </div>

            <!-- Question Card -->
            <div class="bg-slate-800/90 rounded-2xl p-6 md:p-8 border border-slate-700 shadow-2xl space-y-6">
                <!-- Word & Type Header -->
                <div class="text-center space-y-2 border-b border-slate-700/60 pb-6">
                    <div class="inline-block px-3 py-1 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-full text-xs font-semibold uppercase tracking-wider" id="question-word-type">
                        Part of speech
                    </div>
                    <h3 class="text-3xl md:text-4xl font-extrabold text-white tracking-wide" id="question-target-word">
                        WORD
                    </h3><p class="text-slate-400 italic text-sm" id="question-phonetic">/pronunciation/</p>
                    <p class="text-slate-300 text-sm md:text-base mt-2 bg-slate-900/40 py-2 px-4 rounded-xl inline-block border border-slate-700/50" id="question-sentence">
                        "Example sentence..."
                    </p>
                </div>

                <!-- Answer Options -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="options-container">
                    <!-- Options inserted by JS -->
                </div>
            </div>

            <!-- Hint / Explanation Drawer -->
            <div id="explanation-box" class="hidden bg-slate-800/80 border border-slate-700 rounded-xl p-4 text-sm text-slate-300 flex items-start space-x-3">
                <i data-lucide="info" class="w-5 h-5 text-indigo-400 shrink-0 mt-0.5"></i>
                <div>
                    <span class="font-semibold text-indigo-300">Giải thích chi tiết:</span>
                    <p id="explanation-text" class="mt-1 text-slate-300 leading-relaxed"></p>
                </div>
            </div>

            <!-- Next Button -->
            <div class="flex justify-end">
                <button id="next-btn" onclick="nextQuestion()" class="hidden bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-6 py-3 rounded-xl shadow-lg shadow-indigo-600/30 flex items-center space-x-2 transition transform active:scale-95">
                    <span>Câu tiếp theo</span>
                    <i data-lucide="chevron-right" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <!-- View 3: Quiz Result -->
        <div id="view-result" class="hidden text-center space-y-6">
            <div class="bg-slate-800/90 border border-slate-700 rounded-3xl p-8 max-w-xl mx-auto shadow-2xl space-y-6 relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-indigo-500/10 rounded-full blur-3xl"></div>
                
                <div class="w-20 h-20 bg-gradient-to-tr from-indigo-500 to-purple-500 rounded-2xl mx-auto flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <i data-lucide="award" class="w-10 h-10 text-white"></i>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-white">Hoàn Thành Bài Kiểm Tra!</h2>
                    <p class="text-slate-400 text-sm mt-1" id="result-topic-name">Chủ đề: Corporate Strategy</p>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-3 gap-3 bg-slate-900/60 p-4 rounded-2xl border border-slate-700/50">
                    <div>
                        <div class="text-xs text-slate-400">Đúng</div>
                        <div id="res-correct" class="text-2xl font-extrabold text-emerald-400">0/0</div>
                    </div>
                    <div><div class="text-xs text-slate-400">Chính xác</div>
                        <div id="res-accuracy" class="text-2xl font-extrabold text-indigo-400">0%</div>
                    </div>
                    <div>
                        <div class="text-xs text-slate-400">Tổng điểm</div>
                        <div id="res-score" class="text-2xl font-extrabold text-amber-400">0</div>
                    </div>
                </div>

                <div class="pt-2 flex flex-col sm:flex-row gap-3">
                    <button onclick="showTopicSelection()" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 px-4 rounded-xl transition flex items-center justify-center space-x-2">
                        <i data-lucide="grid" class="w-4 h-4"></i>
                        <span>Chọn chủ đề khác</span>
                    </button>
                    <button onclick="downloadStudySheet()" class="flex-1 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold py-3 px-4 rounded-xl shadow-lg transition flex items-center justify-center space-x-2">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>T
